APP_NAME=TraceGeo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lookforgeo.onrender.com

LOG_CHANNEL=stack

# PostgreSQL Database Configuration
DB_CONNECTION=pgsql
DB_HOST=your-database-host.render.com
DB_PORT=5432
DB_DATABASE=your_database_name
DB_USERNAME=your_username
DB_PASSWORD=your_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# GEMINI AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# WHAT3WORDS
WHAT3WORDS_API_KEY=your_what3words_key_here

# OPENWEATHER
OPENWEATHER_API_KEY=your_openweather_api_key_here

# GOOGLE PLACES
GOOGLE_MAPS_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# MAIL
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@tracegeo.com
MAIL_FROM_NAME="${APP_NAME}"

# REDIS
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# OTHER
OPENAI_API_KEY=your_openai_api_key_here
TIMEZONEDB_API_KEY=your_timezonedb_api_key_here