# =============================================================================
# LOCAL DEVELOPMENT TEMPLATE
# Copy this to .env and run: php artisan key:generate
# Production values (APP_KEY, DATABASE_URL, CLOUDINARY_*, GEMINI_API_KEY, ...)
# belong ONLY in the Render dashboard — never in this file, never in git.
# =============================================================================
APP_NAME=TraceGeo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Sessions: file works out of the box (database also fine). Never "array" in prod.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:8000

# Laravel 11+ reads CACHE_STORE, not CACHE_DRIVER.
CACHE_STORE=file
QUEUE_CONNECTION=database

# ---- Database ----
# Local: sqlite only. pgsql + DATABASE_URL are for production (Render) and
# are deliberately refused at boot in local env (see AppServiceProvider).
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql            <-- PRODUCTION ONLY, set in Render dashboard
# DATABASE_URL=postgresql://...  <-- PRODUCTION ONLY, set in Render dashboard

# ---- Mail ----
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Filesystem ----
FILESYSTEM_DISK=local

# ---- Google Gemini (required for analysis; app shows a clear error if unset) ----
# Production must use a billed Gemini tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT=50
GEMINI_TOTAL_BUDGET=110

# Optional OpenAI-compatible vision fallback (used only when Gemini fails).
# Free option (OpenRouter): create key at https://openrouter.ai/settings/keys
# and set the values below. Free :free models are rate-limited (OpenRouter FAQ:
# 50 req/day without credits, 1000/day after >=10 credits purchased).
# Vision-capable free models seen on OpenRouter: nvidia/nemotron-3.5-super-vl:free,
# google/gemma-4-31b-it:free, google/gemma-4-26b-a4b-it:free, openrouter/free.
AI_FALLBACK_ENABLED=false
AI_FALLBACK_PROVIDER=openai_compatible
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
AI_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
AI_FALLBACK_TIMEOUT=60
AI_FALLBACK_HTTP_REFERER=
AI_FALLBACK_APP_TITLE=LookForGeo
GEMINI_CIRCUIT_FAILURES=3
GEMINI_CIRCUIT_OPEN_SECONDS=60
ANALYSIS_REAP_MINUTES=10
ANALYSIS_AUTO_REQUEUE=true
ANALYSIS_REQUEUE_DELAY_SECONDS=8
GEMINI_THINKING_LEVEL=low
GEMINI_HEDGE_AFTER=18
GEMINI_TIMEOUT_OVERRIDES=
GEMINI_THINKING_OVERRIDES=
GEMINI_ESCALATION_MODEL=
GEMINI_ESCALATE_BELOW=60
GEMINI_ESCALATION_TIMEOUT=25
GEMINI_CONFIDENCE_FORWARD_GEOCODE=true

# ---- Third-party APIs (all optional; features degrade gracefully when unset) ----
# Required by the Nominatim usage policy. Use a role address, never a personal email.
# Optional: enables raw counts on /api/health with X-Admin-Token.
HEALTH_ADMIN_TOKEN=
NOMINATIM_CONTACT=
OPENWEATHER_API_KEY=
WHAT3WORDS_API_KEY=
GOOGLE_MAPS_KEY=
GOOGLE_MAPS_EMBED_KEY=

# ---- Cloudinary (OPTIONAL — production image hosting) ----
# Leave empty for local dev: uploads go to the local public disk instead.
# Set in the Render dashboard for production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
