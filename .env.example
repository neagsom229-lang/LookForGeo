APP_NAME=LookForGeo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# ⚠️ IMPORTANT: Do NOT use "array" in production — sessions won't persist.
# For local: file or database. For production: database or redis.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:8000

# ⚠️ Laravel 11+ reads CACHE_STORE, not CACHE_DRIVER.
# CACHE_DRIVER is silently ignored in this version.
CACHE_STORE=file
QUEUE_CONNECTION=database

# ---- Database ----
# For local dev, use sqlite. For production, use postgres (Render provides DATABASE_URL).
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DATABASE_URL=postgresql://user:password@host:5432/database

# ---- Redis (optional, not used on Vercel) ----
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ---- Mail ----
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Filesystem ----
FILESYSTEM_DISK=local

# ---- Google Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# ---- Third-party APIs (all optional, feature-degrades gracefully) ----
OPENWEATHER_API_KEY=
WHAT3WORDS_API_KEY=
GOOGLE_MAPS_KEY=
GOOGLE_MAPS_EMBED_KEY=
TIMEZONEDB_API_KEY=

# ---- Cloudinary (image storage) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Vite ----
VITE_APP_NAME="${APP_NAME}"