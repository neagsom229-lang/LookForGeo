# Laravel
/vendor/
/node_modules/
/public/hot
/public/storage
/storage/*.key
# Runtime directories are created by tracked .gitignore placeholders: git
# cannot track empty dirs, and a fresh clone (or CI checkout) without these
# fails with "bootstrap/cache directory must be present and writable".
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
bootstrap/cache/*.php
.env
.env.backup
.env.*
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log

# IDE
/.idea/
/.vscode/
*.swp
*.swo

# Database
*.sqlite
*.sqlite-journal

# PHP
*.log
*.cache
*.pid

# Composer
composer.phar

# NPM
yarn.lock

# OS
.DS_Store
Thumbs.db

# Real evaluation photos (may contain GPS / personal data) -- keep these
# outside the public repository; only synthetic fixtures are committed.
tests/fixtures/eval/real/
**/real-photos/
**/real_photos/
**/eval-real/
storage/app/eval-real/

# Deployment
.docker/
docker-compose.yml
.vercel
