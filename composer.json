{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tracegeo/lookforgeo",
    "type": "project",
    "description": "AI-powered OSINT image geolocation: identify where a photo was taken (Laravel 12 + Google Gemini).",
    "keywords": ["geolocation", "osint", "gemini", "laravel", "php"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "cloudinary-labs/cloudinary-laravel": "^3.0",
        "google/cloud-ai-platform": "^1.64",
        "google/cloud-storage": "^1.0",
        "guzzlehttp/guzzle": "^7.15",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.10.1",
        "league/iso3166": "^4.7",
        "predis/predis": "^3.5",
        "symfony/clock": "^7.0",
        "symfony/event-dispatcher": "^7.0",
        "symfony/string": "^7.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.15",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nesbot/carbon": "^3.0",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
    "test": "phpunit --exclude-group=slow",
    "test:slow": "phpunit --group=slow",
    "test:decoy": "php scripts/test-decoy.php",
    "test:all": ["@test", "@test:slow"],
    "pint-changed": "php scripts/pint-changed.php",
    "quick": "php scripts/quick.php",
    "js:check": "node --check public/js/csrf-retry.js && node --check public/js/home-upload.js && node --check public/js/confidence-heading.js && node --check public/js/analysis.js && node --check public/sw.js && node --test tests/js/csrf-retry.test.cjs tests/js/home-upload.test.cjs tests/js/confidence-heading.test.cjs",
    "security-audit": "composer audit --no-interaction",
    "ci": ["@test:all", "@test:decoy", "@pint-changed", "@analyse", "@js:check", "@security-audit"],
    "dev": [
        "Composer\\Config::disableProcessTimeout",
        "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1"
    ],
    "setup-local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke.ps1",
    "latency": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/measure-latency.ps1",
    "latency:live": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/measure-latency.ps1 -Live",
    "eval": "php artisan geo:eval",
    "eval:live": "php artisan geo:eval --live",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "analyse:baseline": "phpstan analyse --generate-baseline=phpstan-baseline.neon --no-progress",
    "post-autoload-dump": [
        "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
        "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
        "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-install-cmd": [
        "@php artisan storage:link",
        "@php -r \"if (PHP_OS_FAMILY !== 'Windows') { system('mkdir -p storage/logs && chmod -R 777 storage bootstrap/cache'); }\""
    ]
},
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.2.27"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
