#!/bin/sh
# Fast pre-push gate: composer quick (pint-changed + fast unit/feature tests).
# Full composer ci remains the manual/CI command.
# Install: git config core.hooksPath .githooks
started=$(date +%s 2>/dev/null || echo 0)

# Git for Windows sh may not expose composer as an executable, so try several
# forms. Always detach stdin from Git's ref list. cmd //c ... < /dev/null is
# banner-free in Git Bash; never call cmd without that redirect.
run_composer() {
  if command -v composer >/dev/null 2>&1; then
    composer "$@" < /dev/null
  elif command -v composer.bat >/dev/null 2>&1; then
    cmd //c composer "$@" < /dev/null
  elif command -v php >/dev/null 2>&1 && [ -f "$HOME/.config/composer/composer.phar" ]; then
    php "$HOME/.config/composer/composer.phar" "$@" < /dev/null
  elif command -v composer.phar >/dev/null 2>&1 && command -v php >/dev/null 2>&1; then
    php "$(command -v composer.phar)" "$@" < /dev/null
  elif command -v cmd.exe >/dev/null 2>&1; then
    cmd //c composer "$@" < /dev/null
  else
    echo "pre-push: composer not found (tried composer, composer.bat, composer.phar and cmd). Blocking push." >&2
    return 127
  fi
}

echo "pre-push: checking vendor ..."
if command -v php >/dev/null 2>&1; then
  php scripts/check-vendor.php
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "pre-push: vendor check FAILED. Push blocked." >&2
    exit "$status"
  fi
else
  echo "pre-push: php not found; run composer install. Push blocked." >&2
  exit 1
fi

echo "pre-push: running composer quick ..."
run_composer quick
status=$?
if [ "$status" -ne 0 ]; then
  echo "pre-push: composer quick FAILED (exit $status). Push blocked." >&2
  exit "$status"
fi

echo "pre-push: passed in $(( $(date +%s 2>/dev/null || echo 0) - started ))s."
exit 0
