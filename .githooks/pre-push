#!/bin/sh
# Block the push when the test suite fails.
# Install: git config core.hooksPath .githooks
echo "pre-push: running composer test ..."

# Never invoke cmd.exe here: it consumes Git's stdin refs as commands and
# prints its banner. Call composer.bat directly on Windows and always detach
# stdin from git's ref list.
if command -v composer.bat >/dev/null 2>&1; then
  composer.bat test < /dev/null
elif command -v composer >/dev/null 2>&1; then
  composer test < /dev/null
else
  echo "pre-push: composer not found; blocking push." >&2
  exit 1
fi

status=$?
if [ "$status" -ne 0 ]; then
  echo "pre-push: composer test FAILED (exit $status). Push blocked." >&2
  exit "$status"
fi
echo "pre-push: composer test passed."
exit 0
